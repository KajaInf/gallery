{% extends 'base.html.twig' %}

{% block title %}{{ 'user.password_title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'user.password_title'|trans }}</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}

        <button class="btn btn-primary">
            {{ 'user.change_password'|trans }}
        </button>
    {{ form_end(form) }}

    <br>

    <a href="{{ path('app_user_index') }}" class="btn btn-secondary">
    {{ 'action.back_to_list'|trans }}
</a>
{% endblock %}
