{% extends 'base.html.twig' %}

{% block title %}{{ 'user.delete_title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'user.delete_title'|trans }}</h1>

    <p>
        {{ 'user.delete_confirm'|trans({'%email%': user.email}) }}
    </p>

    {{ include('user/_delete_form.html.twig') }}

    <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-secondary">
        {{ 'action.cancel'|trans }}
    </a>
{% endblock %}
