{% extends 'base.html.twig' %}

{% block title %}{{ 'gallery.delete_title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'gallery.delete_title'|trans }}</h1>

    <p>
        {{ 'gallery.delete_confirm'|trans({'%title%': gallery.title}) }}
    </p>

    {{ include('gallery/_delete_form.html.twig') }}

    <a href="{{ path('app_gallery_show', {'id': gallery.id}) }}" class="btn btn-secondary">
        {{ 'action.cancel'|trans }}
    </a>
{% endblock %}
