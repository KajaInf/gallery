{% extends 'base.html.twig' %}

{% block title %}{{ 'comment.show'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'comment.show'|trans }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{ 'label.id'|trans }}</th>
                <td>{{ comment.id }}</td>
            </tr>
            <tr>
                <th>{{ 'comment.nick'|trans }}</th>
                <td>{{ comment.nick }}</td>
            </tr>
            <tr>
                <th>{{ 'comment.email'|trans }}</th>
                <td>{{ comment.email }}</td>
            </tr>
            <tr>
                <th>{{ 'comment.content'|trans }}</th>
                <td>{{ comment.content }}</td>
            </tr>
            <tr>
                <th>{{ 'comment.created_at'|trans }}</th>
                <td>{{ comment.createdAt ? comment.createdAt|format_datetime('medium', 'medium', locale=app.request.locale) : '' }}</td>
            </tr>
        </tbody>
    </table>

<a href="{{ path('app_comment_index') }}" class="btn btn-secondary mb-2">
    {{ 'action.back_to_list'|trans }}
</a>

<a href="{{ path('app_comment_edit', {'id': comment.id}) }}" class="btn btn-warning mb-2">
    {{ 'action.edit'|trans }}
</a>

<a href="{{ path('app_comment_delete_confirm', {'id': comment.id}) }}" class="btn btn-danger">
    {{ 'action.delete'|trans }}
</a>
{% endblock %}
