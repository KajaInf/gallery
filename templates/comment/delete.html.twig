{% extends 'base.html.twig' %}

{% block title %}{{ 'comment.delete_title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'comment.delete_title'|trans }}</h1>

    <p>
        {{ 'comment.delete_confirm'|trans({'%nick%': comment.nick}) }}
    </p>

    {{ include('comment/_delete_form.html.twig') }}

    <a href="{{ path('app_comment_show', {'id': comment.id}) }}" class="btn btn-secondary">
        {{ 'action.cancel'|trans }}
    </a>
{% endblock %}
