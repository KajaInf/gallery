{% extends 'base.html.twig' %}

{% block title %}{{ 'tag.show'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'tag.show'|trans }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{ 'label.id'|trans }}</th>
                <td>{{ tag.id }}</td>
            </tr>
            <tr>
                <th>{{ 'tag.name'|trans }}</th>
                <td>{{ tag.name }}</td>
            </tr>
        </tbody>
    </table>

<a href="{{ path('app_tag_index') }}" class="btn btn-secondary mb-2">
    {{ 'action.back_to_list'|trans }}
</a>

<a href="{{ path('app_tag_edit', {'id': tag.id}) }}" class="btn btn-warning mb-2">
    {{ 'action.edit'|trans }}
</a>

<a href="{{ path('app_tag_delete_confirm', {'id': tag.id}) }}" class="btn btn-danger">
    {{ 'action.delete'|trans }}
</a>
{% endblock %}
