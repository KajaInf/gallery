{% extends 'base.html.twig' %}

{% block title %}{{ 'tag.delete_title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'tag.delete_title'|trans }}</h1>

    <p>
        {{ 'tag.delete_confirm'|trans({'%name%': tag.name}) }}
    </p>

    {{ include('tag/_delete_form.html.twig') }}

    <a href="{{ path('app_tag_show', {'id': tag.id}) }}" class="btn btn-secondary">
        {{ 'action.cancel'|trans }}
    </a>
{% endblock %}
